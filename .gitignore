.anchor
.DS_Store
node_modules
test-ledger
.yarn
.surfpool
**/*.rs.bk

# Filled-in environment secrets (NEVER commit). The template `.env.example` IS committed.
.env
.env.*
!.env.example

# Local dev-stack state written by `make dev` (validator pid/ledger, demo wallet secret,
# deploy manifest). All regenerated; none belongs in git.
/.localnet/
/deploy-manifest.json

# Compiled TS package output (the off-chain workspace).
packages/*/dist

# Next.js frontend build + test artifacts.
packages/web/.next
packages/web/out
packages/web/playwright-report
packages/web/test-results
# Cloudflare wrangler local dev state (pages dev cache/session).
packages/web/.wrangler
packages/web/.env.local
packages/web/tsconfig.tsbuildinfo
packages/web/e2e/.localnet.json

# Ignore build output, but keep the canonical program keypair committed so the
# program ID is reproducible across clones/worktrees. Without this, every fresh
# build regenerates a new keypair and thus a different program ID.
# NOTE: this is a DEVNET/LOCALNET program keypair — it only identifies the on-chain
# program, it is NOT a funded wallet. Use a separate, secret keypair for mainnet.
/target/*
!/target/deploy/
/target/deploy/*
!/target/deploy/meridian-keypair.json
/.vscode/*
/.claude/*
