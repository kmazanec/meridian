# Meridian automation — droplet env file TEMPLATE.
#
# Copy to a root-owned file on the droplet (e.g. /etc/meridian/automation.env, chmod 600)
# and fill in the real values. This file is passed to the container via `docker run
# --env-file`. NEVER commit a filled-in copy; the keypair is a real secret.
#
# Only the automation job needs these (see packages/automation/src/config.ts).

# The automation signing keypair. Inside the container this must be an INLINE secret
# (JSON byte array or base58) — a host file path won't resolve in the container unless you
# also mount it. Inline is simplest for --env-file. NEVER COMMIT.
AUTOMATION_KEYPAIR=[ ... 64 bytes ... ]

# Solana RPC + the collateral USDC mint (from the deploy manifest).
RPC_URL=https://api.devnet.solana.com
USDC_MINT=Gyyg41J1j72WBY8UnQg6mYPQt2fYtzv8zxEtuJtKUErA

# Price source for the morning job: "mock" or "pyth".
#   - mock: uses MOCK_CLOSE_<SYM> (always works; carries the holiday demo)
#   - pyth: pulls live prices via Hermes; requires FEED_<SYM> + the Pyth peers (in the image)
PRICE_SOURCE=mock

# Mock previous closes (only used when PRICE_SOURCE=mock).
MOCK_CLOSE_AAPL=190
MOCK_CLOSE_MSFT=430
MOCK_CLOSE_GOOGL=175
MOCK_CLOSE_AMZN=205
MOCK_CLOSE_NVDA=120
MOCK_CLOSE_META=680
MOCK_CLOSE_TSLA=345

# Pyth feed ids (only used when PRICE_SOURCE=pyth; must match Config.tickers feed ids).
# FEED_AAPL=49f6b65cb1de6b10eaf75e7c03ca029c306d0357e91b5311b175084a5ad55688
# FEED_MSFT=d0ca23c1cc005e004ccf1db5bf76aeb6a49218f43dac3d4b275e92de12ded4d1
# FEED_GOOGL=5a48c03e9b9cb337801073ed9d166817473697efff0d138874e0f6a33d6d5aa6
# FEED_AMZN=b5d0e0fa58a1f8b81498ae670ce93c872d14434b72c364885d4fa1b257cbb07a
# FEED_NVDA=b1073854ed24cbc755dc527418f52b7d271f6cc967bbf8d8129112b18860a593
# FEED_META=78a3e3b8e676a8f73c439f5d749737034b139bbbe899ba5775216fba596607fe
# FEED_TSLA=16dad506d7db8da01c87581c87ca897a012a153557d4d578c3b9c9e1bc0632f1

# Optional: alert webhook for job failures (Slack/Discord). Default: log-only.
# ALERT_WEBHOOK_URL=https://hooks.example.com/your/webhook
