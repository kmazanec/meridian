# Meridian frontend configuration. Copy to `.env.local` and adjust per cluster.
# The frontend holds NO secrets — these only point it at an RPC and the USDC mint.

# RPC endpoint the read hooks + wallet adapter use.
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899

# The collateral USDC mint from the program's Config. Optional: the app reads it from
# Config on-chain; set this as a bootstrap default (e.g. the mint a local setup script
# creates) so the UI can render before the config fetch resolves.
NEXT_PUBLIC_USDC_MINT=

# Display-only cluster label shown in the header.
NEXT_PUBLIC_CLUSTER=localnet
