{
  "compilerOptions": {
    "target": "es2020",
    // NodeNext module + resolution: this is what makes the LangChain/zod typechecking
    // tractable. The legacy "node" (Node10) resolution ignores those packages' `exports`
    // maps and falls back to declaration shapes that make `tool()`'s generics relate
    // against zod schemas pathologically — ~10M type instantiations for a single tool call
    // (TS2589, multi-GB heap). NodeNext honors `exports`, resolving to the intended types:
    // the same call drops to ~52K instantiations and sub-second checks. NodeNext still
    // emits CommonJS here because this package.json has no `"type": "module"`, matching the
    // other packages and the `node dist/...` runtime.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2020", "dom"],
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "mocha", "chai"]
  },
  "include": ["src", "tests"]
}
