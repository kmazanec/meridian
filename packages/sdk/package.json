{
  "name": "@meridian/sdk",
  "version": "0.1.0",
  "description": "Shared TypeScript client for the Meridian on-chain program: typed instruction builders, PDA derivation, dual-perspective book reads, the four-button intent translation, and Pyth/Hermes price-update helpers.",
  "license": "ISC",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./pyth": {
      "types": "./dist/cjs/pyth.d.ts",
      "import": "./dist/esm/pyth.js",
      "require": "./dist/cjs/pyth.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.cjs.json && tsc -p tsconfig.build.esm.json && node scripts/finalize-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "ts-mocha -p tsconfig.json --timeout 120000 'tests/**/*.test.ts'"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.0.2",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0",
    "bn.js": "^5.2.1"
  },
  "peerDependencies": {
    "@pythnetwork/hermes-client": "^1.0.0",
    "@pythnetwork/pyth-solana-receiver": "^0.16.0"
  },
  "peerDependenciesMeta": {
    "@pythnetwork/hermes-client": {
      "optional": true
    },
    "@pythnetwork/pyth-solana-receiver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@pythnetwork/hermes-client": "^1.0.0",
    "@pythnetwork/pyth-solana-receiver": "^0.16.0",
    "@types/bn.js": "^5.1.5",
    "@types/chai": "^4.3.0",
    "@types/mocha": "^9.0.0",
    "@types/node": "^20.0.0",
    "chai": "^4.3.4",
    "litesvm": "^0.8.0",
    "mocha": "^9.0.3",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.7.3"
  }
}
